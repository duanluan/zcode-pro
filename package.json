{
  "name": "zcode-pro",
  "version": "0.17.1",
  "description": "ZCode Pro — 为 ZCode 桌面版增加界面增强（不修改客户端文件，通过 ZCode Pro 快捷方式启动即可），核心功能：项目自定义别名",
  "type": "module",
  "bin": {
    "zcode-pro": "./bin/zcode-pro.mjs"
  },
  "scripts": {
    "build": "esbuild src/inject/index.js --bundle --format=iife --target=chrome120 --outfile=dist/inject.js",
    "prepack": "npm run build",
    "start": "./bin/zcode-pro"
  },
  "files": [
    "bin/zcode-pro.mjs",
    "cli.mjs",
    "src/",
    "dist/",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duanluan/zcode-pro.git"
  },
  "homepage": "https://github.com/duanluan/zcode-pro",
  "bugs": "https://github.com/duanluan/zcode-pro/issues",
  "keywords": [
    "zcode",
    "zcode-pro",
    "launcher",
    "enhancement"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
