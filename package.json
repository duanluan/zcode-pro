{
  "name": "zcode-pro",
  "version": "1.5.2",
  "description": "ZCode Pro — ZCode 桌面版增强工具：壁纸引擎（图片/视频/网页）、皮肤主题、会话快捷切换、状态栏统计等二十余项界面与体验增强；不修改客户端文件，用 ZCode Pro 快捷方式启动即可生效。",
  "type": "module",
  "bin": {
    "zcode-pro": "./bin/zcode-pro.mjs"
  },
  "scripts": {
    "build": "esbuild src/inject/index.js --bundle --format=iife --target=chrome120 --outfile=dist/inject.js",
    "prepack": "npm run build",
    "start": "./bin/zcode-pro"
  },
  "files": [
    "bin/zcode-pro.mjs",
    "cli.mjs",
    "src/",
    "dist/",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duanluan/zcode-pro.git"
  },
  "homepage": "https://github.com/duanluan/zcode-pro",
  "bugs": "https://github.com/duanluan/zcode-pro/issues",
  "keywords": [
    "zcode",
    "zcode-pro",
    "launcher",
    "enhancement"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
